# Settings for deploy/compose.production.yaml. scripts/install.sh writes this
# file for you with generated secrets; copy it only for a manual install.

# Image tag to run (see https://github.com/0furkancolak/hooklane/releases).
HOOKLANE_VERSION=latest

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Generate with: openssl rand -base64 32
# Back this up: without it stored endpoint secrets cannot be decrypted.
ENDPOINT_SECRET_KEY=

# Uncomment to use an existing PostgreSQL instead of the bundled one.
# DATABASE_URL=postgres://hooklane:password@db.example.com:5432/hooklane?sslmode=require

# Where the proxy listens on the host. Keep 127.0.0.1 and terminate TLS in front.
HOOKLANE_BIND=127.0.0.1
HOOKLANE_PORT=8090

HOOKLANE_API_REPLICAS=1
HOOKLANE_WORKER_REPLICAS=1
WORKER_CONCURRENCY=10

# Per client address, enforced by the proxy across all API replicas.
HOOKLANE_RATE_LIMIT_RPS=50
HOOKLANE_RATE_LIMIT_BURST=200

RETENTION_PERIOD=720h
