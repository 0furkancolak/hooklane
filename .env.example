APP_ENV=development
PORT=8080
DATABASE_URL=postgres://hooklane:local_dev_only_change_me@localhost:5433/hooklane?sslmode=disable
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=5433
# Encrypts endpoint signing secrets at rest. Required by the API.
# Generate with: openssl rand -base64 32
ENDPOINT_SECRET_KEY=
# Docker Compose full stack (docker compose --profile app up):
# host port for the API and dashboard, and the APP_ENV the containers use.
HOOKLANE_PORT=8090
HOOKLANE_APP_ENV=production
# How long finished events are kept; 0 keeps them forever.
RETENTION_PERIOD=720h
# Per-client request limit on /v1 (requests per second, and burst). 0 disables.
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=200
# Optional: serve /metrics, /healthz and /readyz on a separate listener.
# Use different addresses for the API and the worker.
METRICS_ADDR=

# Log encoding: pretty (coloured one-liners, the default in development) or json.
# LOG_FORMAT=json
